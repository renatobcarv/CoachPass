# PostgreSQL (Payload 3 usa @payloadcms/db-postgres)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
PAYLOAD_SECRET=substitua-por-um-segredo-longo-e-aleatorio

# URL pública do app/CMS (mesmo Next.js). Ex.: http://localhost:3000
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Origem extra para CORS/CSRF (opcional). Padrão: mesma URL do servidor.
# FITSYNC_FRONTEND_URL=http://localhost:3000

# Se a API do Payload estiver em outro host (raro). Vazio = mesma origem.
# NEXT_PUBLIC_CMS_URL=http://localhost:3000

# SMTP — recuperação de senha do /admin (Gmail, Resend SMTP, Mailgun, etc.)
# Sem estas variáveis, o Payload usa Ethereal em dev (credenciais aparecem no console).
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=FitSync

# Usuário master (rode: npm run seed:master)
# MASTER_EMAIL=master@seudominio.com
# MASTER_PASSWORD=senha-forte-aqui
