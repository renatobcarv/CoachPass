# PostgreSQL (Payload 3 usa @payloadcms/db-postgres)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
PAYLOAD_SECRET=substitua-por-um-segredo-longo-e-aleatorio

# URL pública do CMS (link de “esqueci minha senha” no e-mail). Ex.: http://localhost:3000 ou https://cms.seudominio.com
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Origem do app Vite (CORS + CSRF). Ex.: http://localhost:5173
FITSYNC_FRONTEND_URL=http://localhost:5173

# SMTP — recuperação de senha do /admin (Gmail, Resend SMTP, Mailgun, etc.)
# Sem estas variáveis, o Payload usa Ethereal em dev (credenciais aparecem no console).
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=FitSync
