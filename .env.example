# PostgreSQL (Payload 3 usa @payloadcms/db-postgres)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL_TEST=postgresql://USER:PASSWORD@HOST:5432/DATABASE_TEST?sslmode=require
PAYLOAD_SECRET=substitua-por-um-segredo-longo-e-aleatorio-minimo-32-chars

# false em produção/homologação. true só em desenvolvimento local.
PAYLOAD_DATABASE_PUSH=false

# URL pública do app/CMS (mesmo Next.js). Ex.: http://localhost:3000
# Na Vercel: https://SEU-PROJETO.vercel.app — precisa existir no BUILD e no runtime.
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Origem extra para CORS/CSRF (opcional). Padrão: mesma URL do servidor.
# FITSYNC_FRONTEND_URL=https://SEU-PROJETO.vercel.app

# Se a API do Payload estiver em outro host (raro). Vazio = mesma origem.
# NEXT_PUBLIC_CMS_URL=http://localhost:3000

# SMTP — Gmail com senha de app (não a senha da conta). Sem isso reset e convite
# só saem no Ethereal (dev). Em produção o app não sobe sem SMTP_HOST + SMTP_USER + SMTP_PASS.
# Google Account → Segurança → Senhas de app. Cole a senha de 16 caracteres em SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-gmail@gmail.com
SMTP_PASS=
SMTP_FROM_EMAIL=seu-gmail@gmail.com
SMTP_FROM_NAME=CoachPass

# Usuário master (rode: npm run seed:master)
MASTER_EMAIL=master@seudominio.com
MASTER_PASSWORD=

# Contas demo (rode: npm run seed:demo). Use aspas se a senha tiver #.
DEMO_PASSWORD=

# Gemini (geração de treino/chat). Sem chave, treino usa catálogo local.
# Se a chave vazou, revogue no AI Studio e cole outra aqui. Nunca commite.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Observabilidade
# SENTRY_DSN=
